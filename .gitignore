# =============================================================================
# server-deploy branch — only code, configs, and docs are tracked.
# Every generated/downloadable artifact is excluded so the branch stays tiny
# and safe to (re)clone on any GPU server.
# =============================================================================

# --- Generated / regenerable directories ------------------------------------
phase7_release/outputs/
phase7_release/features/
phase7_release/raw_hf/
phase7_release/datasets/
phase7_release/data/splits/
phase7_release/data/full_splits/
phase7_release/data/manifests/
phase7_local4server/

